{
  "name": "replay-studio",
  "version": "1.4.0",
  "type": "module",
  "description": "Video markup application with telestrator-style drawing tools",
  "author": "Mark Relph <mrelph@outlook.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "electron-updater": "^6.8.9",
    "fabric": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.575.0",
    "onnxruntime-web": "^1.24.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/fabric": "^5.3.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.replaystudio.app",
    "productName": "Replay Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "dist/models/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mrelph",
        "repo": "replay-studio",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${name}-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${name}-${version}.${ext}",
      "icon": "build/icon.png",
      "category": "Video"
    }
  }
}
